    "defaultPrompt": [
      "\u041f\u043e\u043c\u043e\u0433\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c KETO Companion \u0434\u043b\u044f \u043c\u0435\u043d\u044f. \u041d\u0430\u0447\u043d\u0438 \u0441 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u044f, \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0438 \u0434\u0432\u0443\u0445-\u0442\u0440\u0451\u0445 \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432.",
      "\u041f\u0440\u043e\u0447\u0438\u0442\u0430\u0439 \u043c\u043e\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0435 \u043c\u0435\u043d\u044e \u0441 \u043f\u043e\u043a\u0443\u043f\u043a\u0430\u043c\u0438. \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u043e\u043a\u0430\u0436\u0438 \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a.",
      "\u0417\u0430\u043f\u0438\u0448\u0435\u043c, \u0447\u0442\u043e \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0435\u043b\u0430 \u0438 \u043a\u0430\u043a \u0441\u0435\u0431\u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044e. \u0411\u0435\u0437 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0437\u0432\u0435\u0448\u0438\u0432\u0430\u043d\u0438\u044f."
