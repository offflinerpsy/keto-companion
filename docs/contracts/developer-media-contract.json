{
  "developer": {
    "artifact_prefix": "developer/",
    "editable_files": [
      "cloudflare-saas/public/app.css",
      "cloudflare-saas/public/help.html",
      "cloudflare-saas/public/developer-extension.js"
    ],
    "fixed_test_stages": [
      "syntax",
      "build",
      "product",
      "python"
    ],
    "max_files": 3,
    "max_jobs_day": 3,
    "max_output_tokens": 5000,
    "max_utf8_bytes": 60000,
    "preview": "private same-session artifact, opaque sandbox, synthetic data, network CSP",
    "publication": "separate_verified_release; no broker or publish endpoint",
    "receipt_bindings": [
      "baseline",
      "patch_hash",
      "image_digest"
    ],
    "role": "server-derived admin, active session, CSRF on writes",
    "service_binding": "DEVELOPER_RUNNER",
    "state_to_model": null,
    "task_chars": 2000,
    "ttl_hours_max": 24
  },
  "images": {
    "consent": "processing, storage and health; revision/session rechecked",
    "dns_rebinding_scope": "conservative fixed host allowlist plus all A/AAAA validation; not universal image URL fetching",
    "fetch_bytes_max": 4194304,
    "larger_images": "upload file for local compression",
    "max_redirects": 2,
    "mime": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif"
    ],
    "network_timeout_seconds": 8,
    "port": 443,
    "public_hosts": [
      "images.unsplash.com",
      "images.pexels.com",
      "upload.wikimedia.org"
    ],
    "sanitizer_input_bytes_max": 1000000,
    "saved_on_link_fetch": false,
    "scheme": "https"
  },
  "schema": "keto-developer-media-v1",
